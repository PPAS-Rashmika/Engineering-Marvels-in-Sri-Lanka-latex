\contentsline {figure}{\numberline {2.1}{\ignorespaces Comparison of ideal vs. actual fluid velocity. Ancient engineers minimized internal pipe roughness to keep the actual velocity as close to the ideal theoretical curve as possible.}}{4}{figure.caption.6}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces The Sigiriya Rock Fortress}}{5}{figure.caption.7}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Engineering Structures of Sigiriya Rock}}{5}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Ancient bricks possessed higher porosity to allow the resin-mortar to seep deeply, yet retained remarkably high compressive strength compared to modern equivalents.}}{6}{figure.caption.9}%

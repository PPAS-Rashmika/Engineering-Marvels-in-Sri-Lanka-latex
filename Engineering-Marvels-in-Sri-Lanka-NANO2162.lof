\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Manning's Velocity model. The chosen gradient of 0.0001 (0.01\%) perfectly maintains the velocity between the siltation limit (too slow) and the scouring limit (too fast).}}{10}{figure.caption.13}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces The Flow of Jaya Ganga (Yoda Ela)}}{11}{figure.caption.14}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Engineering Structures of Jaya Ganga (Yoda Ela)}}{11}{figure.caption.15}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces As the arch rise ($f$) increases, the horizontal thrust pushing the piers apart decreases dramatically. The Nine Arches Bridge utilizes deep parabolic curves to minimize this destructive thrust.}}{13}{figure.caption.17}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces The Nine Arches Bridge in Ella}}{14}{figure.caption.18}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Engineering Structures of The Nine Arches Bridge}}{14}{figure.caption.19}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Hydrostatic pressure increases linearly with depth, reaching over 1,100 kPa at the base of the Victoria Dam.}}{16}{figure.caption.20}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces The Victoria Dam Double Curvature Arch}}{17}{figure.caption.21}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Engineering Structures of The Victoria Dam}}{17}{figure.caption.22}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces Applying nano-silica changes the contact angle ($\theta $) to $>90^\circ $, rendering $\cos (\theta )$ negative. This fundamentally stops capillary water absorption, protecting the structure.}}{19}{figure.caption.24}%
